# Copy this file to .env and replace all placeholder values.
XIAOKE_API_KEY=choose-a-long-random-secret
XIAOKE_UPSTREAM_URL=https://your-openai-compatible-upstream/v1
XIAOKE_UPSTREAM_KEY=paste-your-upstream-key-here
XIAOKE_UPSTREAM_TIMEOUT=120
XIAOKE_DB_PATH=data/xiaoke.sqlite
PORT=3010
# Total combined shared-context record limit per request. This is NOT an
# additional injection allowance: client conversation records and xiaoke
# Timeline records share this one limit. Events selected from Timeline also
# consume a record slot and are forwarded to the model.
MAX_HANDOFF_RECORDS=999
# Optional secondary character safety cap for xiaoke-injected Timeline records.
MAX_HANDOFF_CHARS=800000
